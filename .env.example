# Google Gemini API key used by POST /api/tickets/classify/
# If omitted or empty, ticket creation still works without AI pre-fill.
LLM_API_KEY=your_gemini_api_key_here

# PostgreSQL configuration (defaults match docker-compose.yml)
DB_NAME=ticket_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Django runtime settings
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
